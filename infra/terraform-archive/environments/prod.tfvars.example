# infra/terraform/environments/prod.tfvars
#
# Copia in `prod.tfvars` e compila i valori. Il file `.tfvars` è git-ignored.
# Uso:
#   terraform init -backend-config=environments/prod.backend.hcl
#   terraform plan -var-file=environments/prod.tfvars
#   terraform apply -var-file=environments/prod.tfvars

environment    = "prod"
region         = "eu-west-1"
instance_type  = "t3.small"

# Tuo IP pubblico per SSH admin, in formato CIDR /32.
# Scoprilo con:  curl -s https://ifconfig.me
admin_cidr     = "93.XXX.XXX.XXX/32"

# Contenuto di ~/.ssh/tms_admin.pub (genera con `ssh-keygen -t ed25519 -f ~/.ssh/tms_admin`).
# Per mantenere il file pulito, si può anche usare `file("~/.ssh/tms_admin.pub")` via -var.
ssh_public_key = "ssh-ed25519 AAAA... admin@tms"

# Chiave pubblica del deploy SSH usato dalla CI/CD (issue #18).
# Lasciare vuoto alla prima apply; riempire dopo che la CI è configurata.
deploy_ssh_public_key = ""

app_fqdn    = "tms.wheretech.it"
api_fqdn    = "api.tms.wheretech.it"
admin_email = "gcaporossi@wheretech.it"

# Email che riceverà gli alarm CloudWatch. Lascia vuoto per non creare la
# subscription (la aggiungi a mano dopo). AWS invia un'email di conferma.
alert_email = "gcaporossi@wheretech.it"
