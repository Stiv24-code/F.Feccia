# infra/aws/config/prod.env
# Config per il provisioning AWS prod. Copia in `prod.env` (gitignored) e
# compila. Viene sourced da provision.sh e teardown.sh.

# ── Ambiente e regione ────────────────────────────────────────────────────
ENV=prod
AWS_REGION=eu-west-1

# ── EC2 ────────────────────────────────────────────────────────────────────
INSTANCE_TYPE=t3.small
ROOT_VOLUME_GB=30
DATA_VOLUME_GB=20

# Il tuo IP personale in CIDR (per SSH admin). Ricavabile con:
#   curl -s https://ifconfig.me
ADMIN_CIDR=93.XXX.XXX.XXX/32

# Path del file della tua chiave SSH admin (pubblica).
# Generala con: ssh-keygen -t ed25519 -f ~/.ssh/tms_admin
ADMIN_SSH_PUBKEY_FILE=$HOME/.ssh/tms_admin.pub

# Chiave pubblica SSH del deploy user (usata dalla CI/CD).
# Generala con: ssh-keygen -t ed25519 -f ~/.ssh/tms_deploy
# Lascia vuoto al primo provisioning se non hai ancora configurato la CI.
DEPLOY_SSH_PUBKEY_FILE=$HOME/.ssh/tms_deploy.pub

# ── Domini (il DNS è su Google, non Route53) ──────────────────────────────
APP_FQDN=tms.wheretech.it
API_FQDN=api.tms.wheretech.it

# ── Email ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=gcaporossi@wheretech.it    # certbot
ALERT_EMAIL=gcaporossi@wheretech.it    # SNS alarm (conferma manuale via email)
